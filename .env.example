# Application & Server Configuration
PORT=5000
NODE_ENV=development
# Origin of the FE. Also the only origin allowed to use the refresh cookie in production (CORS + CSRF guard)
FRONTEND_URL="http://localhost:3000"

# PostgreSQL Database Connection String (Prisma)
# Default Docker Compose: postgresql://postgres:password123@localhost:5432/boilerplate_db?schema=public
DATABASE_URL="postgresql://postgres:password123@localhost:5432/boilerplate_db?schema=public"

# Authentication Secrets (JWT Dual Token Strategy)
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-minimum-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-minimum-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"
# SameSite of the HttpOnly refresh cookie: strict (FE and API on one site, e.g. app.x & api.x), lax, or none (different sites; forces Secure)
REFRESH_COOKIE_SAMESITE="strict"

# Payload Encryption & Handshake Secrets (AES-256-GCM)
# Must equal NEXT_PUBLIC_APP_SECRET in the FE. It ships to the browser, so it is a shared salt, not a server secret
APP_SECRET="your-app-handshake-secret-minimum-16-chars"
HANDSHAKE_SESSION_TTL=7200

# Payment Gateway Webhook (SHA-512 signature secret). The default is fine for local development only:
# in production the app refuses to start unless this is set to a private value shared with the gateway
PAYMENT_WEBHOOK_SECRET="your-private-payment-webhook-secret"

# Redis Cache & Distributed Session Configuration
# Set REDIS_ENABLED=true jika Redis Server (Docker Compose) sudah menyala
REDIS_ENABLED=false
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# Logging Configuration (Pino Hybrid Transport)
LOG_TO_FILE=false
LOG_FILE_PATH="./logs"
LOG_RETENTION_DAYS=14
