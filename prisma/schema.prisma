// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CASHIER
  KITCHEN
  WAITER
}

enum TableStatus {
  VACANT
  OCCUPIED
  WAITING_PAYMENT
  WAITING_CLEANUP
}

enum OrderStatus {
  PENDING
  PREPARING
  SERVED
  PAID
  CANCELLED
}

enum AttendanceStatus {
  ON_TIME
  LATE
  EARLY_LEAVE
  COMPLETED
  SICK
  LEAVE
  ABSENT
}

enum LeaveType {
  SICK
  ANNUAL_LEAVE
  URGENT_MATTER
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Admin User Model for Authentication & Session Management
model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String    // Hashed with bcrypt/argon2
  name            String
  phone           String?   @unique
  role            UserRole  @default(ADMIN)
  pinCode         String?   @map("pin_code") // Hashed 4-digit PIN for clock-in
  dailyShiftHours Int       @default(8) @map("daily_shift_hours")
  isActive        Boolean   @default(true) @map("is_active")
  avatarUrl       String?   @map("avatar_url")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isPhoneVerified Boolean   @default(false) @map("is_phone_verified")
  refreshToken    String?   // Hashed Refresh Token for revocation strategy
  joinedAt        DateTime  @default(now()) @map("joined_at")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
    updatedAt       DateTime  @updatedAt @map("updated_at")
  attendances     Attendance[]
  leaveRequests   LeaveRequest[]

  @@index([role, isActive, deletedAt])
  @@map("users")
}

/// Category Model for grouping Menu Items (e.g., Coffee, Beverages, Local Favorites, Snacks, Desserts)
model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  sortOrder Int        @default(0) @map("sort_order")
  deletedAt DateTime?  @map("deleted_at")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  menuItems MenuItem[]

  @@index([deletedAt])
  @@map("categories")
}

/// Menu Item Model representing cafe dishes, drinks, snacks, and desserts
model MenuItem {
  id            String                  @id @default(uuid())
  name          String
  description   String?
  price         Decimal                 @db.Decimal(10, 2)
  promoPrice    Decimal?                @db.Decimal(10, 2) @map("promo_price")
  imageUrl      String?                 @map("image_url")
  rating        Decimal                 @default(5.0) @db.Decimal(2, 1)
  reviewCount   Int                     @default(0) @map("review_count")
  isAvailable   Boolean                 @default(true) @map("is_available")
  isBestSeller  Boolean                 @default(false) @map("is_best_seller")
  isRecommended Boolean                 @default(false) @map("is_recommended")
  categoryId    String                  @map("category_id")
  category      Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variantGroups MenuItemVariantGroup[]
  orderItems    OrderItem[]
  deletedAt     DateTime?               @map("deleted_at")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  // Indexes for high-performance public & admin queries
  @@index([categoryId, isAvailable])
  @@index([categoryId, deletedAt])
  @@index([isAvailable])
  @@index([isBestSeller])
  @@index([isRecommended])
  @@index([deletedAt])
  @@map("menu_items")
}

/// Variant Group for Menu Items (e.g., "Pilih Ukuran", "Level Pedas", "Extra Topping")
model MenuItemVariantGroup {
  id         String                  @id @default(uuid())
  menuItemId String                  @map("menu_item_id")
  menuItem   MenuItem                @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String                  // e.g., "Ukuran", "Extra Add-ons"
  isRequired Boolean                 @default(false) @map("is_required") // Mandatory choice (e.g. Size) vs Optional (e.g. Extra Shot)
  minSelect  Int                     @default(0) @map("min_select") // 0 for optional, 1 for required
  maxSelect  Int                     @default(1) @map("max_select") // 1 for single choice, >1 for multiple checkboxes
  options    MenuItemVariantOption[]
  createdAt  DateTime                @default(now()) @map("created_at")

  @@index([menuItemId])
  @@map("menu_item_variant_groups")
}

/// Variant Option Item (e.g., "Large (+Rp 5.000)", "Extra Shot (+Rp 5.000)", "No Sugar (+Rp 0)")
model MenuItemVariantOption {
  id             String               @id @default(uuid())
  variantGroupId String               @map("variant_group_id")
  variantGroup   MenuItemVariantGroup @relation(fields: [variantGroupId], references: [id], onDelete: Cascade)
  name           String               // e.g., "Regular", "Large", "Extra Shot Espresso"
  extraPrice     Decimal              @default(0.00) @db.Decimal(10, 2) @map("extra_price")
  isAvailable    Boolean              @default(true) @map("is_available")
  createdAt      DateTime             @default(now()) @map("created_at")

  @@index([variantGroupId])
  @@map("menu_item_variant_options")
}

/// Promotional Banner Model for Cafe Home Carousel/Banners
model PromoBanner {
  id          String   @id @default(uuid())
  title       String
  description String?
  imageUrl    String   @map("image_url")
  targetUrl   String?  @map("target_url") // Optional link to menu item or category
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("promo_banners")
}

/// Restaurant Table Zone Model for Floor Plan Grouping (e.g. "Indoor (AC Non-Smoking)", "Outdoor Garden", "VIP Lounge")
model TableZone {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String?  @default("amber")
  sortOrder   Int      @default(0) @map("sort_order")
  tables      Table[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("table_zones")
}

/// Restaurant Table Model for QR Code Binding, Seating Types & Table Status Management
model Table {
  id                 String      @id @default(uuid())
  number             String      @unique // Meja 01, Meja 02, VIP-1
  capacity           Int         @default(4)
  status             TableStatus @default(VACANT)
  zoneId             String?     @map("zone_id")
  zone               TableZone?  @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  seatingType        String      @default("DINING") @map("seating_type") // DINING, SOFA, BAR, BOOTH, FAMILY
  tags               String[]    @default([]) // ["OUTLET", "WINDOW_VIEW", "SMOKING", "AC"]
  activeCustomerName String?     @map("active_customer_name")
  orders             Order[]
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@index([zoneId])
  @@map("tables")
}

/// Order Model for Customer Orders & CMS Revenue Tracking
model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique @map("order_number") // #ORD-20260807-001
  tableId      String      @map("table_id")
  table        Table       @relation(fields: [tableId], references: [id])
  customerName String      @map("customer_name")
  status       OrderStatus @default(PENDING)
  totalAmount  Decimal     @db.Decimal(10, 2) @map("total_amount")
  orderItems   OrderItem[]
  paidAt       DateTime?   @map("paid_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([tableId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

/// Order Item Detail Model with Snapshot of Name, Price, and Selected Variants
model OrderItem {
  id               String             @id @default(uuid())
  orderId          String             @map("order_id")
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId       String             @map("menu_item_id")
  menuItem         MenuItem           @relation(fields: [menuItemId], references: [id])
  menuNameSnapshot String             @map("menu_name_snapshot")
  priceSnapshot    Decimal            @db.Decimal(10, 2) @map("price_snapshot")
  quantity         Int
  subtotal         Decimal            @db.Decimal(10, 2)
  notes            String?
  selectedVariants OrderItemVariant[]
  createdAt        DateTime           @default(now()) @map("created_at")

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

/// Snapshot of Selected Variants/Add-ons for Order Items
model OrderItemVariant {
  id                 String    @id @default(uuid())
  orderItemId        String    @map("order_item_id")
  orderItem          OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  groupNameSnapshot  String    @map("group_name_snapshot")  // e.g. "Ukuran"
  optionNameSnapshot String    @map("option_name_snapshot") // e.g. "Large"
  extraPriceSnapshot Decimal   @default(0.00) @db.Decimal(10, 2) @map("extra_price_snapshot")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([orderItemId])
  @@map("order_item_variants")
}


/// Cafe Branch & Geofence Operational Settings Model
model BranchSetting {
  id                 String   @id @default(uuid())
  name               String   @default("Kumpul Cafe - Cabang Pusat")
  address            String   @default("Jl. Tebet Raya No. 45, Jakarta Selatan")
  latitude           Float    @default(-6.2297465)
  longitude          Float    @default(106.8557342)
  geofenceRadius     Int      @default(100) @map("geofence_radius") // in meters
  openTime           String   @default("08:00") @map("open_time")
  closeTime          String   @default("22:00") @map("close_time")
  lateGracePeriod    Int      @default(15) @map("late_grace_period") // in minutes
  isStoreOpen        Boolean  @default(false) @map("is_store_open")
  storeMode          String   @default("SHIFT_DRIVEN") @map("store_mode") // SHIFT_DRIVEN | CLOCK_DRIVEN | QRIS_ONLY | EMERGENCY_CLOSED
  emergencyReason    String?  @map("emergency_reason")
  timezone           String   @default("Asia/Jakarta")
  phone              String?
  email              String?
  schedules          Json?    // Weekly day-by-day open/close schedule
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("branch_settings")
}

/// Smart Staff Attendance & Geofencing Records
model Attendance {
  id                    String            @id @default(uuid())
  branchId              String            @default("default-branch") @map("branch_id")
  staffId               String            @map("staff_id")
  staff                 User              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date                  String            // Format: YYYY-MM-DD
  clockInTime           DateTime?         @map("clock_in_time")
  clockOutTime          DateTime?         @map("clock_out_time")
  status                AttendanceStatus  @default(ON_TIME)
  clockInLat            Float?            @map("clock_in_lat")
  clockInLon            Float?            @map("clock_in_lon")
  clockInDistanceMeters Float?            @map("clock_in_distance_meters")
  isWithinGeofence      Boolean           @default(true) @map("is_within_geofence")
  workDurationMinutes   Int?              @map("work_duration_minutes")
  notes                 String?
  leaveType             LeaveType?        @map("leave_type")
  leaveStatus           LeaveStatus?      @map("leave_status")
  leaveReason           String?           @map("leave_reason")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  @@unique([staffId, date])
  @@index([branchId, date])
  @@index([status])
  @@map("attendances")
}

/// Official Leave & Sick Notice Requests
model LeaveRequest {
  id          String      @id @default(uuid())
  branchId    String      @default("default-branch") @map("branch_id")
  staffId     String      @map("staff_id")
  staff       User        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  leaveType   LeaveType   @map("leave_type")
  startDate   String      @map("start_date") // YYYY-MM-DD
  endDate     String      @map("end_date")   // YYYY-MM-DD
  reason      String
  status      LeaveStatus @default(APPROVED)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([staffId, startDate, endDate])
  @@map("leave_requests")
}

/// Cafe Master Shift Templates
model ShiftTemplate {
  id           String   @id @default(uuid())
  branchId     String   @default("default-branch") @map("branch_id")
  name         String   // e.g. "Shift Pagi (Opening)", "Shift Sore (Closing)", "Shift Middle (Peak)"
  code         String   // e.g. "PAGI", "SORE", "MIDDLE"
  startTime    String   @map("start_time") // "08:00"
  endTime      String   @map("end_time")   // "16:00"
  breakMinutes Int      @default(60) @map("break_minutes")
  colorBadge   String   @default("emerald") @map("color_badge") // emerald, amber, blue, purple, rose
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([branchId])
  @@map("shift_templates")
}
